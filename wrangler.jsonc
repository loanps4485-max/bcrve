{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bcrve",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bcrve-db",
      "database_id": "A_REMPLACER_PAR_LE_DATABASE_ID_CLOUDFLARE"
    }
  ]
}
